set -euo pipefail

current="${FINITE_HOME_PROFILE_PATH:-$HOME/.config/home-manager/profile.json}"
catalog="${FINITE_FOUNDATION_CATALOG:-}"
if [[ -z "$catalog" || ! -r "$catalog" ]]; then
  echo 'The Foundation profile catalog is unavailable.' >&2
  exit 1
fi
if ! jq -e '
  (.roles | type == "object") and
  (.packages | type == "object") and
  ((.classifications // {}) | type == "object") and
  all(.roles[];
    (.label | type == "string") and (.order | type == "number") and
    (.classification == null or (.classification | type == "string"))) and
  all(.packages[];
    (.label | type == "string") and (.description | type == "string") and
    (.order | type == "number")) and
  all((.classifications // {})[]; .label | type == "string")
' "$catalog" >/dev/null; then
  echo 'The Foundation profile catalog is invalid.' >&2
  exit 1
fi
if [[ ! -r "$current" ]]; then
  zenity --error \
    --title='Finite configuration' \
    --text='The local Finite Home Manager profile is unavailable.'
  exit 1
fi

# The schema-3 capability editor and migration flow ship separately at A2.
# Refuse before opening a six-role checklist that cannot represent this profile.
if ! jq -e '.schema == 2' "$current" >/dev/null; then
  echo 'This selector edits schema-2 profiles only; schema-3 editing requires the forthcoming capability editor.' >&2
  exit 2
fi

# Prepare both dialogs before opening either one, so invalid input cannot
# silently produce an empty checklist or partially advance the selector.
if ! role_rows=$(jq -ce --slurpfile profile "$current" '
  . as $catalog |
  [.roles | to_entries | sort_by(.value.order)[] |
    .key as $id | .value as $role |
    [
      (if ($profile[0].roles | index($id)) != null then "TRUE" else "FALSE" end),
      ($catalog.classifications[($role.classification // "")].label // ""),
      $role.label,
      $id
    ]
  ] | flatten
' "$catalog") || ! package_rows=$(jq -ce --slurpfile profile "$current" '
  [.packages | to_entries | sort_by(.value.order)[] |
    .key as $id | .value as $package |
    [
      (if (($profile[0].packages // []) | index($id)) != null then "TRUE" else "FALSE" end),
      $package.label,
      $package.description,
      $id
    ]
  ] | flatten
' "$catalog"); then
  echo 'Unable to read the Foundation profile catalog or current profile.' >&2
  exit 1
fi

mapfile -d '' -t rows < <(jq -j '.[] | ., "\u0000"' <<<"$role_rows")

roles=$(zenity --list --checklist \
  --title='Configure Finite' \
  --text='Select any roles to compose in this Home Manager configuration.' \
  --column='Use' --column='Classification' --column='Role' --column='id' \
  --hide-column=4 --print-column=4 --separator=, "${rows[@]}") || exit 0

mapfile -d '' -t rows < <(jq -j '.[] | ., "\u0000"' <<<"$package_rows")

packages=$(zenity --list --checklist \
  --title='Configure Finite packages' \
  --text='Select optional Nix packages. Finite builds the complete Home Manager generation before changing your profile.' \
  --column='Use' --column='Package' --column='Description' --column='id' \
  --hide-column=4 --print-column=4 --separator=, "${rows[@]}") || exit 0

exec finite-home-apply --roles "$roles" --packages "$packages"
