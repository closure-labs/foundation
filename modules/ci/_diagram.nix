let
  features = (import ../flake/features/_loader.nix {}).features;
  count = prefix: toString (builtins.length (builtins.filter
    (id: builtins.substring 0 (builtins.stringLength prefix) id == prefix) (builtins.attrNames features)));
in ''
<!-- Generated by write-ci-graph. -->
# Foundation module graph

```mermaid
flowchart LR
  F["Feature descriptors: ${toString (builtins.length (builtins.attrNames features))}"] --> C["Pure catalogs and profile roots"]
  F --> D["Ordered Den composition"]
  F --> G["Versioned CI graph"]
  C --> D
  C --> G
  G --> CI["Affected cases and checks"]
```

Discovered applications: ${count "apps/"}; roles: ${count "roles/"}; capabilities: ${count "capabilities/"}.
Discovery registers features. Profile roots activate them. Home evaluation checks actual Den membership against the graph.
''
