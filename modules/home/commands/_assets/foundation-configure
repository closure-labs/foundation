set -euo pipefail

case "${1:-}" in
  -h|--help) echo 'Usage: foundation home configure'; exit 0 ;;
  '') [[ $# -eq 0 ]] || exit 2 ;;
  *) echo 'usage: foundation home configure' >&2; exit 2 ;;
esac

# The helper resolves the consumer's locked source; packaged catalogs can be stale.
context=$(foundation-home-apply --editor-context)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
if ! jq -e '
  .schema == 1 and .profile.schema == 3 and
  (.catalog.roles | type == "object") and (.catalog.packages | type == "object") and
  ((.catalog.classifications // {}) | type == "object") and
  all(.catalog.roles[]; (.label | type == "string") and (.order | type == "number") and
    (.classification == null or (.classification | type == "string"))) and
  all(.catalog.packages[]; (.label | type == "string") and (.description | type == "string") and (.order | type == "number")) and
  all((.catalog.classifications // {})[]; .label | type == "string")
' <<<"$context" >/dev/null; then
  echo 'The locked Foundation editor catalog is invalid.' >&2
  exit 2
fi
jq '.catalog' <<<"$context" >"$work/catalog.json"
jq '.profile' <<<"$context" >"$work/profile.json"
catalog="$work/catalog.json"
current="$work/profile.json"
schema=$(jq -r '.catalog.profileSchema // .profile.schema' <<<"$context")
if [[ "$schema" != 3 ]]; then
  echo 'The locked Foundation editor format is unsupported.' >&2
  exit 2
fi
if ! jq -e '
  (.capabilities | type == "object") and
  all(.capabilities[]; (.label | type == "string") and (.order | type == "number") and
    (.applications | type == "array") and all(.applications[]; type == "string"))
' "$catalog" >/dev/null; then
  echo 'The locked Foundation capability catalog is invalid.' >&2
  exit 2
fi

role_rows=$(jq -ce --slurpfile profile "$current" '
  . as $catalog |
  [.roles | to_entries | sort_by(.value.order, .key)[] |
    .key as $id | .value as $role |
    [((($profile[0].roles | index($id)) != null) | if . then "TRUE" else "FALSE" end),
     ($catalog.classifications[($role.classification // "")].label // ""), $role.label, $id]
  ] | flatten
' "$catalog")
package_rows=$(jq -ce --slurpfile profile "$current" '
  [.packages | to_entries | sort_by(.value.order, .key)[] |
    .key as $id | .value as $package |
    [(((($profile[0].packages // []) | index($id)) != null) | if . then "TRUE" else "FALSE" end),
     $package.label, $package.description, $id]
  ] | flatten
' "$catalog")
  capability_rows=$(jq -ce --slurpfile profile "$current" '
    [.capabilities | to_entries | sort_by(.value.order, .key)[] |
      .key as $id | .value as $capability |
      [(((($profile[0].capabilities // []) | index($id)) != null) | if . then "TRUE" else "FALSE" end),
       $capability.label, ($capability.applications | join(", ")), $id]
    ] | flatten
  ' "$catalog")
mapfile -d '' -t rows < <(jq -j '.[] | ., "\u0000"' <<<"$role_rows")
roles=$(zenity --list --checklist \
  --title='Configure Foundation' --text='Select roles for this Home Manager configuration.' \
  --column='Use' --column='Classification' --column='Role' --column='id' \
  --hide-column=4 --print-column=4 --separator=, "${rows[@]}") || exit 0
mapfile -d '' -t rows < <(jq -j '.[] | ., "\u0000"' <<<"$package_rows")
packages=$(zenity --list --checklist \
  --title='Configure Foundation packages' --text='Select optional Nix packages.' \
  --column='Use' --column='Package' --column='Description' --column='id' \
  --hide-column=4 --print-column=4 --separator=, "${rows[@]}") || exit 0
mapfile -d '' -t rows < <(jq -j '.[] | ., "\u0000"' <<<"$capability_rows")
capabilities=$(zenity --list --checklist \
  --title='Additional capabilities' \
  --text='Role and hardware defaults are included automatically. Select additional capabilities to keep independently of your roles.' \
  --column='Use' --column='Capability' --column='Applications' --column='id' \
  --hide-column=4 --print-column=4 --separator=, "${rows[@]}") || exit 0
change=(--roles "$roles" --packages "$packages" --capabilities "$capabilities")
preview=$(foundation-home-apply "${change[@]}" --preview)
if ! jq -e '.schema == 1 and .preview.status == "preview" and .preview.activationAllowed == false and
  (.summary | type == "string") and (.approvalToken | type == "string" and test("^[a-f0-9]{64}$"))' <<<"$preview" >/dev/null; then
  jq -r '.preview.reason // "Unable to preview this profile change."' <<<"$preview" >&2
  exit 2
fi
jq -r '.summary' <<<"$preview" >"$work/preview.txt"
zenity --text-info --title='Review profile changes' --filename="$work/preview.txt" \
  --width=760 --height=560 --ok-label='Build and apply' --cancel-label='Cancel' || exit 0
foundation-home-apply "${change[@]}" --approve-preview "$(jq -r '.approvalToken' <<<"$preview")"
